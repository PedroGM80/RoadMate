local.properties

# Vosk offline Spanish speech model — fetched into assets at build time by
# the :app downloadVoskModel task, not stored in git (see app/build.gradle.kts).
/app/src/main/assets/vosk-model-small-es-0.42.zip

# BRouter routing jar — fetched at build time by :data:downloadBRouterJar.
/data/libs/

# Firebase config — per-project, embeds an API key + project number. Add your
# own to turn Crashlytics on; its absence just disables Firebase (see
# app/build.gradle.kts).
/app/google-services.json

# Release signing — never in git. Copy keystore.properties.example and point
# it at a keystore kept outside the repo (see app/build.gradle.kts).
/keystore.properties
*.jks
*.keystore

.idea/
