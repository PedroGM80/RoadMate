<?xml version="1.0" encoding="utf-8"?>
<!--
  Warm amber, top to bottom, matching the accent the phone app already uses
  for the mic button and the map tab. Deliberately a plain gradient: adaptive
  icon backgrounds get cropped to whatever mask the launcher applies, so
  anything with detail in it loses the detail on half the devices out there.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF6A723" />
                <item android:offset="1.0" android:color="#FFA9490A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
