<?xml version="1.0" encoding="utf-8"?>
<!--
  A speech bubble with a voice waveform in it: someone in the car talking to
  you, which is what RoadMate is. The old icon was a studio microphone, which
  reads as "podcast" more than "copilot", and a lone mic says nothing about
  where it is used.

  The bars are drawn in the background's amber rather than punched out as
  holes so the shape stays a single filled bubble at 48dp, where a thin
  outline would disappear. `monochrome` gets its own drawable for that reason.

  Everything sits inside the adaptive icon's safe zone (the central 66dp), so
  no launcher mask can clip the tail off.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,32H70A12,12 0 0,1 82,44V58A12,12 0 0,1 70,70H52L40,81L41,70H38A12,12 0 0,1 26,58V44A12,12 0 0,1 38,32Z" />
    <path
        android:strokeColor="#FFB4560C"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M42,46V56" />
