<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ backup/transfer rules. Same reasoning as backup_rules.xml: the
  memory DB, the debug trace and the big model/tile caches never leave the
  device. See PRIVACY.md.

  device-transfer (phone-to-phone) keeps the same exclusions — the models and
  tiles are re-downloadable and the trace is diagnostics, and treating the
  memory DB as device-local is the honest reading of "stored on-device".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="roadmate.db" />
        <exclude domain="database" path="roadmate.db-shm" />
        <exclude domain="database" path="roadmate.db-wal" />
        <exclude domain="file" path="aicore_debug.log" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="vosk-es" />
        <exclude domain="file" path="brouter" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="roadmate.db" />
        <exclude domain="database" path="roadmate.db-shm" />
        <exclude domain="database" path="roadmate.db-wal" />
        <exclude domain="file" path="aicore_debug.log" />
        <exclude domain="file" path="models" />
        <exclude domain="file" path="vosk-es" />
        <exclude domain="file" path="brouter" />
    </device-transfer>
</data-extraction-rules>
