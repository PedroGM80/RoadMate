<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Da acceso al micrófono del coche a través del host (CarAudioRecord).
         Sin esto CarAudioRecord.create() lanza SecurityException. No sustituye
         a RECORD_AUDIO: esa sigue haciendo falta para el micro del móvil. -->
    <uses-permission android:name="androidx.car.app.MICROPHONE" />
    <!-- Plantillas de mapa del host. Sin ella el host rechaza la plantilla
         con SecurityException: "The car app does not have a required
         permission: androidx.car.app.MAP_TEMPLATES". -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />
    <!-- Dibujar el mapa propio sobre la superficie del coche. El host solo
         concede ACCESS_SURFACE a las apps de categoría NAVIGATION, de ahí el
         intent-filter del CarAppService más abajo. -->
    <uses-permission android:name="androidx.car.app.ACCESS_SURFACE" />
    <!-- NavigationTemplate / MapWithContentTemplate. -->
    <uses-permission android:name="androidx.car.app.NAVIGATION_TEMPLATES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Car App Library: declares the app targets the templates host (Android
         Auto / Automotive OS). required=false so phones without it still
         install. Part of the standard Car App Library manifest setup. -->
    <uses-feature
        android:name="android.software.car.templates_host"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <!-- Music apps RoadMate can open by voice — needed for
             getLaunchIntentForPackage() to see them on Android 11+. -->
        <package android:name="com.spotify.music" />
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:name=".RoadMateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoadMate">

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <!-- Must match the highest @RequiresCarApi actually used in the car
             code, not just "1". HomeCarScreen builds a Header and calls
             PaneTemplate.Builder#setHeader(Header) — setHeader is
             @RequiresCarApi(7) in androidx.car.app 1.7.0 (Header itself is
             only @RequiresCarApi(5)). Declaring "1" here tells the host this
             app can run on API level 1-6 hosts too; on one of those the
             setHeader() call would throw at runtime the first time the
             template is drawn. There is no lint check for this — the
             library's AAR ships no lint.jar — so this has to be verified by
             hand against the androidx.car.app sources whenever the car UI
             changes what template APIs it calls. -->
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="7" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RoadMate"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="dev.pgm.roadmate.service.SilenceDetectionForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name="dev.pgm.roadmate.service.WakeWordForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name="dev.pgm.roadmate.tile.AskTileService"
            android:exported="true"
            android:icon="@drawable/lucide_ic_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="dev.pgm.roadmate.reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name="dev.pgm.roadmate.widget.RoadMateWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ask_info" />
        </receiver>

        <service
            android:name="dev.pgm.roadmate.car.RoadMateCarAppService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <!-- NAVIGATION, no POI: solo esta categoría obtiene
                     ACCESS_SURFACE, y sin superficie no hay forma de pintar
                     el mapa propio ni de tener controles de mapa (zoom,
                     centrado, pan) en el coche. Implica que Google la revisa
                     como app de navegación al publicarla: hay que enseñar
                     mapa y guiado, no solo asistente de voz. -->
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
            <!-- Las apps de navegación tienen que aceptar la intención de
                 navegar hacia un destino; sin esto el host no las considera
                 completas. -->
            <intent-filter>
                <action android:name="androidx.car.app.action.NAVIGATE" />
                <data android:scheme="geo" />
            </intent-filter>
        </service>
    </application>

</manifest>