# Release signing for RoadMate. Copy this file to `keystore.properties` (which
# is gitignored) and fill in the real values, or set the equivalent
# ROADMATE_KEYSTORE_* environment variables on CI. Without either, the release
# build is left unsigned.
#
# Create the keystore once, and keep the .jks OUTSIDE this repo:
#
#   keytool -genkey -v \
#     -keystore ~/keys/roadmate-release.jks \
#     -alias roadmate -keyalg RSA -keysize 2048 -validity 10000
#
# Losing this keystore means you can never update the app on Play again
# (unless Play App Signing holds the upload key for you — recommended).

storeFile=/absolute/path/to/roadmate-release.jks
storePassword=CHANGE_ME
keyAlias=roadmate
keyPassword=CHANGE_ME
